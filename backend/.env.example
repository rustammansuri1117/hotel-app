PORT=5000

# PostgreSQL connection
# Local database example:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/hotel_db

# Supabase direct connection (note: if password has '?', use %3F):
# DATABASE_URL=postgresql://postgres:CB2af..iVB%3FJFdH@db.byzsavsmfvsrmgduyxms.supabase.co:5432/postgres

# Supabase connection pooler (recommended for Render & IPv4 networks):
# DATABASE_URL=postgresql://postgres.byzsavsmfvsrmgduyxms:CB2af..iVB%3FJFdH@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Or individual parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=hotel_db
DB_SSL=false

# Allowed frontend origin(s), comma separated or '*'
CORS_ORIGIN=*
